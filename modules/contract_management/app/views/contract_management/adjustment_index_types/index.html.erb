<% html_title t("contract_management.adjustment_index_types.label_plural") %>

<%= render(Primer::OpenProject::PageHeader.new) do |header|
      header.with_title { t("contract_management.adjustment_index_types.label_plural") }
      header.with_description { t("contract_management.adjustment_index_types.description") }
      header.with_breadcrumbs(
        [{ href: project_contract_management_contracts_path(@project), text: t("contract_management.label_plural") },
         { href: project_contract_management_adjustment_indices_path(@project), text: t("contract_management.adjustment_indices.label_plural") },
         t("contract_management.adjustment_index_types.label_plural")]
      )
    end %>

<% if User.current.allowed_in_project?(:manage_contracts, @project) %>
  <%= render(Primer::OpenProject::SubHeader.new) do |subheader|
        subheader.with_action_button(
          tag: :a,
          scheme: :primary,
          leading_icon: :plus,
          label: t("contract_management.adjustment_index_types.new"),
          href: new_project_contract_management_adjustment_index_type_path(@project)
        ) { t("contract_management.adjustment_index_types.new") }
        subheader.with_action_button(
          tag: :a,
          leading_icon: :sync,
          label: t("contract_management.adjustment_index_types.synchronize"),
          href: synchronize_project_contract_management_adjustment_index_types_path(@project),
          data: { turbo_method: :post }
        ) { t("contract_management.adjustment_index_types.synchronize") }
      end %>
<% end %>

<% if @adjustment_index_types.any? %>
  <table class="generic-table">
    <thead>
      <tr>
        <th><%= ContractAdjustmentIndexType.human_attribute_name(:name) %></th>
        <th><%= ContractAdjustmentIndexType.human_attribute_name(:external_series_code) %></th>
        <th><%= ContractAdjustmentIndexType.human_attribute_name(:periodicity) %></th>
        <th><%= ContractAdjustmentIndexType.human_attribute_name(:active) %></th>
        <th><%= ContractAdjustmentIndexType.human_attribute_name(:last_synced_at) %></th>
        <th><%= ContractAdjustmentIndexType.human_attribute_name(:last_sync_error) %></th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @adjustment_index_types.each do |index_type| %>
        <tr>
          <td><%= index_type.name %></td>
          <td><%= index_type.external_series_code %></td>
          <td><%= t("contract_management.periodicities.#{index_type.periodicity}") %></td>
          <td><%= index_type.active? ? t(:general_text_yes) : t(:general_text_no) %></td>
          <td><%= index_type.last_synced_at ? format_time(index_type.last_synced_at) : "—" %></td>
          <td><%= index_type.last_sync_error.presence || "—" %></td>
          <td>
            <% if User.current.allowed_in_project?(:manage_contracts, @project) %>
              <%= link_to t(:button_edit), edit_project_contract_management_adjustment_index_type_path(@project, index_type) %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <%= render(Primer::Beta::Blankslate.new) do |blankslate|
        blankslate.with_visual_icon(icon: :gear)
        blankslate.with_heading(tag: :h2) { t("contract_management.adjustment_index_types.empty") }
        blankslate.with_description { t("contract_management.adjustment_index_types.empty_description") }
      end %>
<% end %>
