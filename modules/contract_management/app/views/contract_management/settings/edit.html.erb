<% title = t("contract_management.settings.title") %>
<%= render(Primer::OpenProject::PageHeader.new) do |header|
      header.with_title { title }
      header.with_breadcrumbs(
        [{ href: project_contract_management_contracts_path(@project), text: t("contract_management.label_plural") }, title]
      )
    end %>

<%= error_messages_for @contract_setting %>
<%= form_with model: @contract_setting,
              url: project_contract_management_settings_path(@project),
              method: :patch,
              html: { class: "contract-management-form" } do |form| %>
  <fieldset class="form--fieldset">
    <legend class="form--fieldset-legend"><%= t("contract_management.settings.commitments") %></legend>
    <div class="form--field -required">
      <%= form.label :commitment_consumption_alert_percentage, class: "form--label" %>
      <%= form.number_field :commitment_consumption_alert_percentage,
                            min: 1,
                            max: 100,
                            step: 0.01,
                            class: "form--text-field" %>
      <span class="form--field-instructions"><%= t("contract_management.settings.alert_hint") %></span>
    </div>
  </fieldset>
  <%= styled_button_tag t(:button_save), class: "-primary" %>
<% end %>
