<section id="budget_commitments" class="contract-commitments">
  <div class="contract-commitments__header">
    <div>
      <h2><%= t("contract_management.commitments.label_plural") %></h2>
      <p><%= t("contract_management.commitments.alert_configured", percentage: @contract_setting.commitment_consumption_alert_percentage) %></p>
    </div>
    <% if User.current.allowed_in_project?(:manage_contracts, @project) %>
      <%= link_to t("contract_management.commitments.new_appropriation"),
                  new_project_contract_management_contract_budget_commitment_path(
                    @project,
                    @contract,
                    kind: "appropriation"
                  ),
                  class: "button -primary" %>
    <% end %>
  </div>

  <% if commitments.any? %>
    <div class="contract-dashboard__table-scroll">
      <table class="generic-table">
        <thead>
          <tr>
            <th><%= ContractBudgetCommitment.human_attribute_name(:kind) %></th>
            <th><%= ContractBudgetCommitment.human_attribute_name(:number) %></th>
            <th><%= ContractBudgetCommitment.human_attribute_name(:fiscal_year) %></th>
            <th><%= ContractBudgetCommitment.human_attribute_name(:total_amount) %></th>
            <th><%= ContractBudgetCommitment.human_attribute_name(:consumed_amount) %></th>
            <th><%= ContractBudgetCommitment.human_attribute_name(:remaining_amount) %></th>
            <th><%= ContractBudgetCommitment.human_attribute_name(:execution_percentage) %></th>
            <th><%= ContractBudgetCommitment.human_attribute_name(:status) %></th>
            <th><%= ContractBudgetCommitment.human_attribute_name(:responsible) %></th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% commitments.each do |commitment| %>
            <tr class="<%= "contract-commitments__alert" if commitment.alert? %>">
              <td><%= t("contract_management.commitments.kinds.#{commitment.kind}") %></td>
              <td><strong><%= commitment.number %></strong></td>
              <td><%= commitment.fiscal_year %></td>
              <td><%= number_to_currency(commitment.total_amount) %></td>
              <td><%= number_to_currency(commitment.consumed_amount) %></td>
              <td><%= number_to_currency(commitment.remaining_amount) %></td>
              <td>
                <div class="contract-commitments__progress" role="progressbar"
                     aria-valuemin="0" aria-valuemax="100"
                     aria-valuenow="<%= commitment.execution_percentage %>">
                  <span style="width: <%= [commitment.execution_percentage, 100].min %>%"></span>
                </div>
                <%= number_to_percentage(commitment.execution_percentage, precision: 1) %>
                <% if commitment.alert? %>
                  <span class="contract-commitments__alert-label"><%= t("contract_management.commitments.consumption_alert") %></span>
                <% end %>
              </td>
              <td><%= t("contract_management.commitments.statuses.#{commitment.status}") %></td>
              <td><%= commitment.responsible.name %></td>
              <td>
                <% if User.current.allowed_in_project?(:manage_contracts, @project) %>
                  <% if commitment.future? && commitment.remaining_amount.positive? %>
                    <%= link_to t("contract_management.commitments.convert"),
                                new_project_contract_management_contract_budget_commitment_conversion_path(
                                  @project,
                                  @contract,
                                  commitment
                                ) %>
                  <% else %>
                    <%= link_to t(:button_edit),
                                edit_project_contract_management_contract_budget_commitment_path(
                                  @project,
                                  @contract,
                                  commitment
                                ) %>
                  <% end %>
                <% end %>
              </td>
            </tr>
            <tr class="contract-commitments__months">
              <td colspan="10">
                <% ContractBudgetCommitment::MONTHS.each do |month| %>
                  <span><strong><%= I18n.t("date.abbr_month_names")[month] %></strong> <%= number_to_currency(commitment.month_amount(month)) %></span>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p class="op-uc-empty-state"><%= t("contract_management.no_records") %></p>
  <% end %>
</section>
