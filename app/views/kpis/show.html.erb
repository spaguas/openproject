<% html_title @kpi.name %>

<% can_manage = User.current.allowed_in_project?(:manage_kpis, @project) &&
                User.current.allowed_in_project?(:edit_project, @project) %>

<%=
  render Primer::OpenProject::PageHeader.new do |header|
    header.with_title { @kpi.name }
    header.with_breadcrumbs(
      [
        { href: project_overview_path(@project.id), text: @project.name },
        { href: project_kpis_path(@project), text: t(:label_kpi_plural) },
        @kpi.name
      ]
    )
  end
%>

<% if can_manage %>
  <%=
    render(Primer::OpenProject::SubHeader.new) do |subheader|
      subheader.with_action_button(
        scheme: :primary,
        leading_icon: :pulse,
        label: t("kpis.measurements.add"),
        tag: :a,
        href: "#new-kpi-measurement"
      ) do
        t("kpis.measurements.add")
      end

      subheader.with_action_button(
        leading_icon: :pencil,
        label: t(:button_edit),
        tag: :a,
        href: edit_project_kpi_path(@project, @kpi)
      ) do
        t(:button_edit)
      end
    end
  %>
<% end %>

<div class="attributes-group">
  <div class="attributes-key-value">
    <div class="attributes-key-value--key"><%= Kpi.human_attribute_name(:status) %></div>
    <div class="attributes-key-value--value-container"><%= t("kpis.statuses.#{@kpi.status}") %></div>
  </div>
  <div class="attributes-key-value">
    <div class="attributes-key-value--key"><%= t("kpis.progress") %></div>
    <div class="attributes-key-value--value-container">
      <progress max="100" value="<%= @kpi.progress_percentage %>"></progress>
      <%= @kpi.progress_percentage %>%
    </div>
  </div>
  <div class="attributes-key-value">
    <div class="attributes-key-value--key"><%= Kpi.human_attribute_name(:current_value) %></div>
    <div class="attributes-key-value--value-container"><%= @kpi.display_value(@kpi.current_value) %></div>
  </div>
  <div class="attributes-key-value">
    <div class="attributes-key-value--key"><%= Kpi.human_attribute_name(:target_value) %></div>
    <div class="attributes-key-value--value-container"><%= @kpi.display_value(@kpi.target_value) %></div>
  </div>
  <div class="attributes-key-value">
    <div class="attributes-key-value--key"><%= Kpi.human_attribute_name(:direction) %></div>
    <div class="attributes-key-value--value-container"><%= t("kpis.directions.#{@kpi.direction}") %></div>
  </div>
  <div class="attributes-key-value">
    <div class="attributes-key-value--key"><%= Kpi.human_attribute_name(:measurement_frequency) %></div>
    <div class="attributes-key-value--value-container"><%= t("kpis.frequencies.#{@kpi.measurement_frequency}") %></div>
  </div>
  <div class="attributes-key-value">
    <div class="attributes-key-value--key"><%= t("kpis.next_measurement") %></div>
    <div class="attributes-key-value--value-container">
      <%= @kpi.next_measurement_at ? format_time(@kpi.next_measurement_at) : "-" %>
    </div>
  </div>
  <div class="attributes-key-value">
    <div class="attributes-key-value--key"><%= Kpi.human_attribute_name(:category) %></div>
    <div class="attributes-key-value--value-container"><%= @kpi.category_name.presence || "-" %></div>
  </div>
  <div class="attributes-key-value">
    <div class="attributes-key-value--key"><%= Kpi.human_attribute_name(:owner) %></div>
    <div class="attributes-key-value--value-container"><%= @kpi.owner&.name || "-" %></div>
  </div>
  <div class="attributes-key-value">
    <div class="attributes-key-value--key"><%= Kpi.human_attribute_name(:projects) %></div>
    <div class="attributes-key-value--value-container"><%= @kpi.associated_projects.map(&:name).join(", ") %></div>
  </div>
  <div class="attributes-key-value">
    <div class="attributes-key-value--key"><%= Kpi.human_attribute_name(:groups) %></div>
    <div class="attributes-key-value--value-container"><%= @kpi.groups.map(&:name).join(", ").presence || "-" %></div>
  </div>
  <div class="attributes-key-value">
    <div class="attributes-key-value--key"><%= Kpi.human_attribute_name(:start_date) %></div>
    <div class="attributes-key-value--value-container"><%= @kpi.start_date ? format_date(@kpi.start_date) : "-" %></div>
  </div>
  <div class="attributes-key-value">
    <div class="attributes-key-value--key"><%= Kpi.human_attribute_name(:due_date) %></div>
    <div class="attributes-key-value--value-container">
      <%= @kpi.due_date ? format_date(@kpi.due_date) : "-" %>
      <% if @kpi.overdue? %>
        <span class="danger"><%= t("kpis.overdue") %></span>
      <% end %>
    </div>
  </div>
</div>

<% if @kpi.description.present? %>
  <h3><%= Kpi.human_attribute_name(:description) %></h3>
  <div class="wiki op-uc-container">
    <%= format_text(@kpi.description, object: @kpi) %>
  </div>
<% end %>

<% if can_manage %>
  <h3 id="new-kpi-measurement"><%= t("kpis.measurements.new") %></h3>
  <%= error_messages_for "measurement" %>

  <%= form_with model: @measurement,
                url: project_kpi_measurements_path(@project, @kpi),
                local: true,
                html: { class: "form" } do |form| %>
    <div class="form--field -required">
      <%= form.label :value, class: "form--label" %>
      <span class="form--field-container">
        <%= form.number_field :value, step: "0.0001", required: true, class: "form--text-field" %>
      </span>
    </div>

    <div class="form--field -required">
      <%= form.label :measured_at, class: "form--label" %>
      <span class="form--field-container">
        <%= form.datetime_local_field :measured_at, required: true, class: "form--text-field" %>
      </span>
    </div>

    <div class="form--field">
      <%= form.label :note, class: "form--label" %>
      <span class="form--field-container">
        <%= form.text_area :note, rows: 3, class: "form--text-field" %>
      </span>
    </div>

    <%= styled_button_tag t("kpis.measurements.add"), class: "-primary -with-icon icon-checkmark" %>
  <% end %>
<% end %>

<h3><%= t("kpis.measurements.history") %></h3>

<% if @measurements.any? %>
  <table class="generic-table">
    <thead>
      <tr>
        <th><%= KpiMeasurement.human_attribute_name(:measured_at) %></th>
        <th><%= KpiMeasurement.human_attribute_name(:value) %></th>
        <th><%= KpiMeasurement.human_attribute_name(:note) %></th>
        <th><%= KpiMeasurement.human_attribute_name(:author) %></th>
        <th><%= KpiMeasurement.human_attribute_name(:created_at) %></th>
      </tr>
    </thead>
    <tbody>
      <% @measurements.each do |measurement| %>
        <tr>
          <td><%= format_time(measurement.measured_at) %></td>
          <td><%= @kpi.display_value(measurement.value) %></td>
          <td><%= simple_format(measurement.note) %></td>
          <td><%= measurement.author&.name || t("kpis.measurements.legacy_author") %></td>
          <td><%= format_time(measurement.created_at) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <%= no_results_box %>
<% end %>

<% if can_manage %>
  <p>
    <%= link_to t(:button_delete),
                project_kpi_path(@project, @kpi),
                data: { turbo_method: :delete, turbo_confirm: t(:text_are_you_sure) },
                class: "button -danger" %>
  </p>
<% end %>
